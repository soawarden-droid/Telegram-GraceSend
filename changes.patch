+/*
+ * Grace Send countdown bar — the slim bar shown above the composer while a
+ * message is inside its 10-second grace window: "Sending in 0:07" + Undo.
+ * Tapping the bar or the Undo label cancels the send.
+ *
+ * Part of the Grace Send feature patch; see org.telegram.messenger.GraceSend.
+ */
+package org.telegram.ui.Components;
+
+import android.content.Context;
+import android.graphics.Typeface;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.Theme;
+
+public class GraceSendBar extends FrameLayout {
+
+    private final TextView labelView;
+    private Runnable undoAction;
+
+    public GraceSendBar(Context context, Theme.ResourcesProvider resourcesProvider) {
+        super(context);
+        setBackground(Theme.createRoundRectDrawable(AndroidUtilities.dp(12), Theme.getColor(Theme.key_chat_messagePanelBackground, resourcesProvider)));
+
+        labelView = new TextView(context);
+        labelView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        labelView.setSingleLine(true);
+        labelView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider));
+        addView(labelView, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.LEFT | Gravity.CENTER_VERTICAL, 12, 0, 0, 0));
+
+        TextView undoView = new TextView(context);
+        undoView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        undoView.setSingleLine(true);
+        undoView.setTypeface(Typeface.DEFAULT_BOLD);
+        undoView.setText(LocaleController.getString(R.string.Undo));
+        undoView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider));
+        undoView.setPadding(AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12), 0);
+        addView(undoView, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.MATCH_PARENT, Gravity.RIGHT | Gravity.CENTER_VERTICAL));
+
+        OnClickListener undoClick = v -> {
+            if (undoAction != null) {
+                undoAction.run();
+            }
+        };
+        undoView.setOnClickListener(undoClick);
+        setOnClickListener(undoClick);
+    }
+
+    public void setUndoAction(Runnable undoAction) {
+        this.undoAction = undoAction;
+    }
+
+    public void setCountdown(int seconds) {
+        labelView.setText(LocaleController.formatString(R.string.GraceSendSendingIn, seconds));
+    }
+}
