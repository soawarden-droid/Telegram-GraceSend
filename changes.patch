+    //region Grace Send (feature patch: 10-second undo window for sends)
+
+    private GraceSendBar graceSendBar;
+    private long graceSendBarGroupId = -1;
+    private boolean graceSendListening;
+
+    private final Runnable graceSendTickRunnable = new Runnable() {
+        @Override
+        public void run() {
+            updateGraceSendBar();
+        }
+    };
+
+    private final GraceSend.Listener graceSendListener = new GraceSend.Listener() {
+        @Override
+        public void onGraceSendChanged(long dialogId) {
+            if (dialogId == dialog_id) {
+                updateGraceSendBar();
+            }
+        }
+
+        @Override
+        public void onGraceSendUndo(long dialogId, CharSequence text) {
+            if (dialogId == dialog_id && editingMessageObject == null && messageEditText != null && TextUtils.isEmpty(messageEditText.getText())) {
+                setFieldText(text);
+            }
+        }
+    };
+
+    /*
+     * Grace Send hook: offer the fully-built params to the grace window
+     * instead of dispatching them right away. Edits, sends attached to a
+     * forward, and schedule-mode sends always go out immediately.
+     */
+    private boolean tryGraceSend(SendMessagesHelper.SendMessageParams params, CharSequence fullText) {
+        if (editingMessageObject != null || isInScheduleMode()) {
+            return false;
+        }
+        if (delegate != null && delegate.hasForwardingMessages()) {
+            return false;
+        }
+        if (!graceSendListening) {
+            graceSendListening = true;
+            GraceSend.getInstance(currentAccount).addListener(graceSendListener);
+        }
+        return GraceSend.getInstance(currentAccount).hold(dialog_id, params, fullText);
+    }
+
+    private void updateGraceSendBar() {
+        GraceSend.PendingGroup group = GraceSend.getInstance(currentAccount).getEarliest(dialog_id);
+        if (group == null) {
+            if (graceSendBar != null) {
+                graceSendBar.setVisibility(GONE);
+            }
+            AndroidUtilities.cancelRunOnUIThread(graceSendTickRunnable);
+            graceSendBarGroupId = -1;
+            return;
+        }
+        if (graceSendBar == null) {
+            graceSendBar = new GraceSendBar(getContext(), resourcesProvider);
+            graceSendBar.setUndoAction(() -> {
+                if (graceSendBarGroupId != -1) {
+                    GraceSend.getInstance(currentAccount).undo(graceSendBarGroupId);
+                }
+            });
+        }
+        graceSendBarGroupId = group.id;
+        ViewGroup parent = (ViewGroup) getParent();
+        if (parent != null && graceSendBar.getParent() != parent) {
+            parent.addView(graceSendBar, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 38, Gravity.LEFT | Gravity.BOTTOM, 7, 0, 7, 0));
+        }
+        ViewGroup.MarginLayoutParams layoutParams = (ViewGroup.MarginLayoutParams) graceSendBar.getLayoutParams();
+        if (layoutParams != null) {
+            layoutParams.bottomMargin = getHeight() + AndroidUtilities.dp(6);
+        }
+        graceSendBar.setCountdown(group.secondsLeft());
+        graceSendBar.setVisibility(VISIBLE);
+        AndroidUtilities.cancelRunOnUIThread(graceSendTickRunnable);
+        AndroidUtilities.runOnUIThread(graceSendTickRunnable, 200);
+    }
+
+    //endregion
+
