+/*
+ * Grace Send — a 10-second undo window before a message truly leaves.
+ *
+ * Part of a small feature patch for Telegram for Android.
+ * Written for this patch; not part of the upstream project.
+ *
+ * How it works: when the user presses Send in a chat, ChatActivityEnterView
+ * builds the usual SendMessagesHelper.SendMessageParams but, instead of
+ * dispatching them at once, hands them to hold(). The params are kept here,
+ * untouched, for DELAY_SECONDS. A countdown bar above the composer offers
+ * Undo. On expiry the params are passed to the normal send path, unchanged.
+ * On Undo the params are dropped — nothing ever left the phone — and the
+ * original text is given back to the composer.
+ */
+package org.telegram.messenger;
+
+import android.os.SystemClock;
+import android.text.SpannableStringBuilder;
+
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.Iterator;
+
+public class GraceSend {
+
+    public static final int DELAY_SECONDS = 10;
+    public static final String PREF_KEY = "grace_send";
+
+    private static volatile GraceSend[] Instance = new GraceSend[UserConfig.MAX_ACCOUNT_COUNT];
+
+    public static GraceSend getInstance(int num) {
+        GraceSend localInstance = Instance[num];
+        if (localInstance == null) {
+            synchronized (GraceSend.class) {
+                localInstance = Instance[num];
+                if (localInstance == null) {
+                    Instance[num] = localInstance = new GraceSend(num);
+                }
+            }
+        }
+        return localInstance;
+    }
+
+    public interface Listener {
+        void onGraceSendChanged(long dialogId);
+
+        void onGraceSendUndo(long dialogId, CharSequence text);
+    }
+
+    public static class PendingGroup {
+        public final long id;
+        public final long dialogId;
+        /* the text exactly as it stood in the composer, kept for Undo */
+        public final CharSequence text;
+        private final CharSequence textRef;
+        private final long deadline;
+        private final ArrayList<SendMessagesHelper.SendMessageParams> parts = new ArrayList<>();
+        private Runnable expireRunnable;
+
+        private PendingGroup(long id, long dialogId, CharSequence text, CharSequence textRef, long deadline) {
+            this.id = id;
+            this.dialogId = dialogId;
+            this.text = text;
+            this.textRef = textRef;
+            this.deadline = deadline;
+        }
+
+        public int secondsLeft() {
+            long left = deadline - SystemClock.uptimeMillis();
+            if (left <= 0) {
+                return 0;
+            }
+            return (int) ((left + 999) / 1000);
+        }
+    }
+
+    private final int currentAccount;
+    private final ArrayList<PendingGroup> groups = new ArrayList<>();
+    private final ArrayList<WeakReference<Listener>> listeners = new ArrayList<>();
+    private long nextId = 1;
+
+    private GraceSend(int num) {
+        currentAccount = num;
+    }
+
+    public static boolean isEnabled() {
+        return MessagesController.getGlobalMainSettings().getBoolean(PREF_KEY, true);
+    }
+
+    public void addListener(Listener listener) {
+        for (WeakReference<Listener> ref : listeners) {
+            if (ref.get() == listener) {
+                return;
+            }
+        }
+        listeners.add(new WeakReference<>(listener));
+    }
+
+    /*
+     * Try to hold a fully-built send for the grace window.
+     * Returns true when the send was held (the caller must NOT dispatch it),
+     * false when the caller should send immediately as usual.
+     * Scheduled sends and paid (stars) sends are never held.
+     * All calls happen on the UI thread.
+     */
+    public boolean hold(long dialogId, SendMessagesHelper.SendMessageParams params, CharSequence fullText) {
+        if (!isEnabled() || params == null || fullText == null) {
+            return false;
+        }
+        if (params.scheduleDate != 0 || params.payStars > 0) {
+            return false;
+        }
+        PendingGroup group = null;
+        if (!groups.isEmpty()) {
+            PendingGroup last = groups.get(groups.size() - 1);
+            if (last.dialogId == dialogId && last.textRef == fullText) {
+                // one more part of the same long message, split by the caller
+                group = last;
+            }
+        }
+        if (group == null) {
+            group = new PendingGroup(nextId++, dialogId, new SpannableStringBuilder(fullText), fullText,
+                    SystemClock.uptimeMillis() + DELAY_SECONDS * 1000L);
+            final PendingGroup g = group;
+            group.expireRunnable = () -> expire(g);
+            AndroidUtilities.runOnUIThread(group.expireRunnable, DELAY_SECONDS * 1000L);
+            groups.add(group);
+        }
+        group.parts.add(params);
+        notifyChanged(dialogId);
+        return true;
+    }
+
+    public PendingGroup getEarliest(long dialogId) {
+        PendingGroup best = null;
+        for (PendingGroup group : groups) {
+            if (group.dialogId == dialogId && (best == null || group.deadline < best.deadline)) {
+                best = group;
+            }
+        }
+        return best;
+    }
+
+    public void undo(long groupId) {
+        PendingGroup group = null;
+        for (PendingGroup g : groups) {
+            if (g.id == groupId) {
+                group = g;
+                break;
+            }
+        }
+        if (group == null) {
+            return;
+        }
+        AndroidUtilities.cancelRunOnUIThread(group.expireRunnable);
+        groups.remove(group);
+        // the params are simply dropped: nothing was ever dispatched
+        notifyChanged(group.dialogId);
+        for (Listener listener : aliveListeners()) {
+            listener.onGraceSendUndo(group.dialogId, group.text);
+        }
+    }
+
+    private void expire(PendingGroup group) {
+        if (!groups.remove(group)) {
+            return;
+        }
+        for (SendMessagesHelper.SendMessageParams params : group.parts) {
+            SendMessagesHelper.getInstance(currentAccount).sendMessage(params);
+        }
+        notifyChanged(group.dialogId);
+    }
+
+    private void notifyChanged(long dialogId) {
+        for (Listener listener : aliveListeners()) {
+            listener.onGraceSendChanged(dialogId);
+        }
+    }
+
+    private ArrayList<Listener> aliveListeners() {
+        ArrayList<Listener> alive = new ArrayList<>();
+        Iterator<WeakReference<Listener>> it = listeners.iterator();
+        while (it.hasNext()) {
+            Listener listener = it.next().get();
+            if (listener == null) {
+                it.remove();
+            } else {
+                alive.add(listener);
+            }
+        }
+        return alive;
+    }
+}
